# Public Supabase configuration (inlined into the browser bundle at build time)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase and database credentials
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Server-only Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Server-only LiveKit configuration
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Internal caller authentication
WORKER_SERVICE_TOKEN=
INFERENCE_SERVICE_TOKEN=
CRON_SECRET=

# Service origins
APP_ORIGIN=http://localhost:3000
INFERENCE_ORIGIN=http://localhost:3000

# Server-only visual emotion provider (region: us or cn)
FACEPLUSPLUS_API_KEY=
FACEPLUSPLUS_API_SECRET=
FACEPLUSPLUS_REGION=us

# Server-only voice emotion provider
HUME_API_KEY=
HUME_CONFIG_ID=
